<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Pharmacy</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/sidebar.css" />
</head>
<body>
    <!-- Hamburger Icon -->
    <div class="menu-icon" onclick="toggleSidebar()">
        &#9776;
    </div>

    <!-- Sidebar -->
    <div id="sidebar" class="sidebar">
        <h2>Pharmacy</h2>
        <a href="/Dashboard"><i class="fa fa-home"></i> Dashboard</a>
        <a href="/Medicines"><i class="fa fa-pills"></i> Medicines</a>
        <a href="/Categories"><i class="fa fa-list"></i> Categories</a>
        <a href="/Stock"><i class="fa fa-boxes"></i> Stock</a>
        <a href="/Suppliers"><i class="fa fa-truck"></i> Suppliers</a>
        <a href="/Orders"><i class="fa fa-shopping-cart"></i> Orders</a>
        <a href="/Reports"><i class="fa fa-chart-bar"></i> Reports</a>
        <a href="/Settings"><i class="fa fa-cog"></i> Settings</a>
        <a href="/Logout"><i class="fa fa-sign-out-alt"></i> Logout</a>
    </div>

   

    <!-- Main content -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="/js/sidebar.js"></script>

</body>
</html>
