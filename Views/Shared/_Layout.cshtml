@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Pharmacy Inventory</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <style>
        body {
            overflow-x: hidden;
            background-color: #f8f9fa;
        }

        /* Sidebar */
        .sidebar {
            min-height: 100vh;
            background-color: #212529;
        }

            .sidebar .nav-link {
                color: #ffffff;
                padding: 12px 16px;
                border-radius: 4px;
                margin: 4px 8px;
                transition: all 0.2s ease;
            }

                .sidebar .nav-link:hover {
                    background-color: #343a40;
                }

                .sidebar .nav-link.active {
                    background-color: #0d6efd;
                }

        /* Main content */
        main {
            background-color: #f8f9fa;
            min-height: calc(100vh - 56px);
        }
    </style>
</head>

<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark bg-dark sticky-top">
        <div class="container-fluid">
            <button class="btn btn-dark d-md-none"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#sidebarMenu">
                ☰
            </button>

            <span class="navbar-brand ms-2">
                Pharmacy Inventory System
            </span>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <nav id="sidebarMenu"
                 class="col-md-3 col-lg-2 d-md-block sidebar collapse">

                <div class="position-sticky pt-3">

                    <h6 class="text-white text-center mb-4">
                        Pharmacy Panel
                    </h6>

                    <ul class="nav flex-column">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Medicines" ? "active" : "")"
                               asp-controller="Medicines"
                               asp-action="Index">
                                💊 Medicines
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Reports" ? "active" : "")"
                               asp-controller="Reports"
                               asp-action="Index">
                                📊 Reports
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Suppliers"
                               asp-action="Index">
                                🚚 Suppliers
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link">
                                ⚙️ Settings
                            </a>
                        </li>

                    </ul>
                </div>
            </nav>

            <!-- MAIN CONTENT -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Scripts -->
    <a href="~/lib/jquery/dist/jquery.min.map">~/lib/jquery/dist/jquery.min.map</a>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
