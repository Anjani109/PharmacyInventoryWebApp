<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Pharmacy Inventory</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Custom CSS -->
    <link href="~/css/site.css" rel="stylesheet" />
</head>

<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-dark bg-dark">
        <button class="btn btn-dark d-md-none" onclick="toggleSidebar()">☰</button>
        <span class="navbar-brand ms-3">Pharmacy Inventory</span>
    </nav>

    <div class="container-fluid">
        <div class="row">

            <!-- SIDEBAR -->
            <nav class="sidebar">
                <ul class="nav flex-column mt-3">
                    <li class="nav-item">
                        <a asp-controller="Medicines" asp-action="Index" class="nav-link">Medicines</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Medicines" asp-action="Create" class="nav-link">Add Medicine</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link">Stock</a>
                    </li>
                </ul>
            </nav>

            <!-- MAIN CONTENT -->
            <main class="main-content">
                @RenderBody()
            </main>

        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

</body>
</html>

