@model PharmacyInventoryWebApp.Models.Medicine

@{
    ViewData["Title"] = "Delete Medicine";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Confirm Delete</h4>
        </div>

        <div class="card-body">
            <p class="text-danger fw-bold">
                Are you sure you want to delete this medicine?
            </p>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.MedicineName</dd>

                <dt class="col-sm-4">Company</dt>
                <dd class="col-sm-8">@Model.CompanyName</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">₹ @Model.UnitPrice</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="MedicineId" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Delete</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
