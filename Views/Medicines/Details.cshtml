@model PharmacyInventoryWebApp.Models.Medicine

@{
    ViewData["Title"] = "Medicine Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h4 class="mb-0">Medicine Details</h4>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.MedicineName</dd>

                <dt class="col-sm-4">Company</dt>
                <dd class="col-sm-8">@Model.CompanyName</dd>

                <dt class="col-sm-4">Category</dt>
                <dd class="col-sm-8">@Model.Category</dd>

                <dt class="col-sm-4">Price</dt>
                <dd class="col-sm-8">₹ @Model.UnitPrice</dd>

                <dt class="col-sm-4">Status</dt>
                <dd class="col-sm-8">
                    @(Model.IsActive ? "Active" : "Inactive")
                </dd>

                <dt class="col-sm-4">Created Date</dt>
                <dd class="col-sm-8">@Model.CreatedDate</dd>
            </dl>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.MedicineId" class="btn btn-warning">Edit</a>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>
