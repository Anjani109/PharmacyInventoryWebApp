@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

@{
    ViewData["Title"] = "Pharmacy Medicines";
    var sort = Context.Request.Query["sortOrder"].ToString();
}

<div class="container mt-4">

    <!-- Page Heading -->
    <h2 class="mb-3">Pharmacy Medicines</h2>

    <!-- Search + Sort + Add Button Row -->
    <div class="row mb-3 align-items-center">

        <!-- SEARCH + SORT (LEFT) -->
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="d-flex gap-2">

                <!-- Search -->
                <input type="text"
                       name="searchString"
                       value="@Context.Request.Query["searchString"]"
                       class="form-control"
                       placeholder="Search by name, company, category..." />

                <!-- Sort -->
                <select name="sortOrder"
                        class="form-select"
                        style="max-width: 220px;"
                        onchange="this.form.submit()">

                    <option value="">Sort by Name (A–Z)</option>
                    <option value="name_desc"
                            selected="@(Context.Request.Query["sortOrder"] == "name_desc")">
                        Name (Z–A)
                    </option>
                    <option value="price_asc"
                            selected="@(Context.Request.Query["sortOrder"] == "price_asc")">
                        Price (Low → High)
                    </option>
                    <option value="price_desc"
                            selected="@(Context.Request.Query["sortOrder"] == "price_desc")">
                        Price (High → Low)
                    </option>

                </select>

                <!-- Search Button -->
                <button type="submit" class="btn btn-primary">
                    Search
                </button>
                <select name="status" class="form-select me-2" onchange="this.form.submit()">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>


                <!-- Clear -->
                <a asp-action="Index" class="btn btn-secondary">
                    Clear
                </a>

            </form>
        </div>

        <!-- ADD BUTTON (RIGHT) -->
        <div class="col-md-4 text-end">
            <a asp-action="Create" class="btn btn-primary">
                + Add New Medicine
            </a>
        </div>
    </div>

    <!-- Medicines Table -->
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Category</th>
                <th>Price (₹)</th>
                <th>Quantity</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MedicineName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.Category</td>
                        <td>@item.UnitPrice.ToString("0.00")</td>
                        <td>@item.Quantity</td>
                        <td>@item.ExpiryDate.ToShortDateString()</td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.MedicineId"
                               class="btn btn-sm btn-warning">Edit</a>

                            <a asp-action="Details" asp-route-id="@item.MedicineId"
                               class="btn btn-sm btn-info">Details</a>

                            <a asp-action="Delete" asp-route-id="@item.MedicineId"
                               class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-4">
                        <i class="bi bi-inbox fs-3 text-muted"></i>
                        <p class="text-muted mt-2">No medicines found</p>
                    </td>

                </tr>
            }
        </tbody>
        

    </table>
<!-- Pagination -->
<nav>
    <ul class="pagination justify-content-center mt-3">

        <!-- Previous -->
        <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage - 1)"
               asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-sortOrder="@ViewBag.SortOrder">
                Previous
            </a>
        </li>

        <!-- Page Numbers -->
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i"
                   asp-route-searchString="@ViewBag.CurrentFilter"
                   asp-route-sortOrder="@ViewBag.SortOrder">
                    @i
                </a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link"
               asp-action="Index"
               asp-route-page="@(ViewBag.CurrentPage + 1)"
               asp-route-searchString="@ViewBag.CurrentFilter"
               asp-route-sortOrder="@ViewBag.SortOrder">
                Next
            </a>
        </li>

    </ul>
</nav>


</div>



