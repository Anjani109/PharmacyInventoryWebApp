@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

@{
    ViewData["Title"] = "Pharmacy Medicines";
    var sort = Context.Request.Query["sortOrder"].ToString();
    var canManageMedicine = User.IsInRole("Admin") || User.IsInRole("Manager");
}
<div class="container mt-4">

    <!-- Page Heading -->
    <h2 class="mb-3">Pharmacy Medicines</h2>

    <!-- Search + Sort + Add Button Row -->
    <div class="row mb-3 align-items-center">

        <!-- SEARCH + SORT (LEFT) -->
        <div class="col-md-8">
            <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap">

                <!-- Search -->
                <input type="text"
                       name="searchString"
                       value="@Context.Request.Query["searchString"]"
                       class="form-control"
                       placeholder="Search by name, company, category..." />

                <!-- Sort -->
                <select name="sortOrder" class="form-select w-auto" onchange="this.form.submit()">
                    <option value="">Name (A–Z)</option>
                    <option value="name_desc">Name (Z–A)</option>
                    <option value="price_asc">Price (Low → High)</option>
                    <option value="price_desc">Price (High → Low)</option>
                </select>


                <!-- Status Filter -->
                <select name="status"
                        class="form-select"
                        style="max-width: 160px;"
                        onchange="this.form.submit()">
                    <option value="">All Status</option>
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>

                <!-- Search Button -->
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <!-- Clear -->
                <a asp-action="Index" class="btn btn-secondary">
                    Clear
                </a>

            </form>
        </div>

        <!-- ADD BUTTON (RIGHT) -->
        <div class="col-md-4 text-end">
            @if (canManageMedicine)
            {
                <a asp-action="Create" class="btn btn-primary">
                    + Add New Medicine
                </a>
            }
        </div>

    </div>

    <!-- Medicines Table -->
    <table class="table table-bordered table-hover align-middle">

        <thead class="table-dark text-center">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Category</th>
                <th>Price (₹)</th>
                <th>Quantity</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr class="@(item.Quantity < 6 ? "table-warning" : "")">

                        <td>@item.MedicineName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.Category</td>
                        <td>@item.UnitPrice.ToString("0.00")</td>

                        <!-- Quantity + Low Stock -->
                        <td class="text-center">
                            @item.Quantity

                            @if (item.Quantity < 6)
                            {
                                <span class="badge bg-danger ms-2">
                                    Low Stock
                                </span>
                            }
                        </td>

                        <td>@item.ExpiryDate.ToShortDateString()</td>

                        <!-- Status Badge -->
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>

                        <!-- Action Buttons -->
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@item.MedicineId"
                               class="btn btn-sm btn-info text-white me-1">
                                Details
                            </a>

