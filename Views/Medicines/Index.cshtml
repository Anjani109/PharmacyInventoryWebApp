@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

@{
    ViewData["Title"] = "Pharmacy Medicines";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Pharmacy Medicines</h2>

    <div class="mb-3 text-end">
        <a asp-action="Create" class="btn btn-primary">+ Add New Medicine</a>
    </div>

    <table class="table table-bordered table-hover align-middle">
        <thead class="table-dark text-center">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Category</th>
                <th>Price (₹)</th>
                <th>Status</th>
                <th style="width: 220px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MedicineName</td>
                        <td>@item.CompanyName</td>
                        <td>@item.Category</td>
                        <td>@item.UnitPrice.ToString("0.00")</td>
                        <td class="text-center">
                            <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                @(item.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.MedicineId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.MedicineId" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Delete" asp-route-id="@item.MedicineId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No medicines available.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
