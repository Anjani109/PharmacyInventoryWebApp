
@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

@{
    ViewData["Title"] = "Medicines";
}

<div class="container mt-4">
    <h2 class="text-center mb-4">Pharmacy Medicines</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary">+ Add New Medicine</a>
    </p>

    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Company</th>
                <th>Category</th>
                <th>Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null)
        {
            <tr>
                <td colspan="5">No data received</td>
            </tr>
        }
         else
         {
             @foreach (var item in Model)
            {
                <tr>
                    <td>@item.MedicineName</td>
                    <td>@item.CompanyName</td>
                    <td>@item.Category</td>
                    <td>₹ @item.UnitPrice</td>
                    <td>
                        @(item.IsActive ? "Active" : "Inactive")
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.MedicineId" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Details" asp-route-id="@item.MedicineId" class="btn btn-sm btn-info">Details</a>
                        <a asp-action="Delete" asp-route-id="@item.MedicineId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
            }
        </tbody>
    </table>
</div>

