@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

@{
    ViewData["Title"] = "Dashboard";
    var role = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Manager") ? "Manager" : "Pharmacist";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Welcome, @User.Identity?.Name</h3>
        <p class="text-muted mb-0">Role: @role</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm p-3 text-center">
            <h6>Total Medicines</h6>
            <h3 class="text-primary">@ViewBag.TotalMedicines</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 text-center">
            <h6>Low Stock</h6>
            <h3 class="text-warning">@ViewBag.LowStockCount</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm p-3 text-center">
            <h6>Active Suppliers</h6>
            <h3 class="text-success">@ViewBag.ActiveSuppliers</h3>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="mb-0">Low Stock Medicines</h5>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Medicine</th>
                    <th>Company</th>
                    <th>Category</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MedicineName</td>
                            <td>@item.CompanyName</td>
                            <td>@item.Category</td>
                            <td><span class="badge bg-danger">@item.Quantity</span></td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-3">No low stock medicines.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
