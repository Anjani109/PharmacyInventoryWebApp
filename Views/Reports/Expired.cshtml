@model IEnumerable<PharmacyInventoryWebApp.Models.Medicine>

<h2>Expired Medicines</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Company</th>
            <th>Category</th>
            <th>Expiry Date</th>
            <th>Quantity</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var med in Model)
        {
            <tr>
                <td>@med.MedicineName</td>
                <td>@med.CompanyName</td>
                <td>@med.Category</td>
                <td>@med.ExpiryDate.ToShortDateString()</td>
                <td>@med.Quantity</td>
            </tr>
        }
    </tbody>
</table>
